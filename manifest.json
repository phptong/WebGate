{
  "manifest_version": 3,
  "name": "WebGate",
  "version": "1.1.1",
  "description": "Extension-first local WebGate with web-ready shared architecture and WebLLM service-worker bridge.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "apps/extension/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "apps/extension/popup.html"
  }
}
